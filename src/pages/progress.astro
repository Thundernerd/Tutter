---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProgressBar from '../components/ProgressBar.astro';
import { getTutorials } from '../lib/content';

const tutorials = await getTutorials();
---

<BaseLayout title="Progress">
  <header class="tutorial-header">
    <h1>Progress</h1>
    <p class="lede">
      Progress is stored in this browser only. To move it to another device, export it here and import the file there.
      Imports are merged, so nothing you've done on either device is lost.
    </p>
  </header>

  <section class="panel">
    <h2>Tutorials</h2>
    {tutorials.length === 0 && <p class="muted">No tutorials yet.</p>}
    <ul class="stats-list">
      {tutorials.map((t) => (
        <li>
          <a href={t.url}>{t.data.title}</a>
          <ProgressBar pageIds={t.pages.map((p) => p.id)} />
        </li>
      ))}
    </ul>
    <p class="muted" id="quiz-stats"></p>
  </section>

  <section class="panel">
    <h2>Backup &amp; sync</h2>
    <div class="button-row">
      <button type="button" class="btn btn-primary" id="export">Export progress</button>
      <label class="btn" for="import-file">Import progress…</label>
      <input type="file" id="import-file" accept="application/json,.json" hidden />
      <button type="button" class="btn btn-danger" id="reset">Reset all progress</button>
    </div>
    <p class="notice" id="notice" role="status" aria-live="polite"></p>
  </section>
</BaseLayout>

<script>
  import { getProgress, onProgressChange, ProgressImportError } from '../lib/progress';

  const store = getProgress();
  const notice = document.querySelector<HTMLElement>('#notice')!;
  const say = (text: string, kind: 'ok' | 'error' = 'ok') => {
    notice.textContent = text;
    notice.dataset.kind = kind;
  };

  onProgressChange(() => {
    const { quizzes, pages } = store.get();
    const all = Object.values(quizzes);
    const solved = all.filter((q) => q.correct).length;
    document.querySelector('#quiz-stats')!.textContent =
      `${Object.keys(pages).length} pages completed · ${solved} of ${all.length} attempted quizzes solved`;
  });

  document.querySelector('#export')!.addEventListener('click', () => {
    const blob = new Blob([store.exportJSON()], { type: 'application/json' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `tutter-progress-${new Date().toISOString().slice(0, 10)}.json`;
    a.click();
    URL.revokeObjectURL(a.href);
    say('Progress exported.');
  });

  const fileInput = document.querySelector<HTMLInputElement>('#import-file')!;
  fileInput.addEventListener('change', async () => {
    const file = fileInput.files?.[0];
    if (!file) return;
    try {
      const merged = store.importJSON(await file.text());
      say(`Imported. You now have ${Object.keys(merged.pages).length} completed pages.`);
    } catch (err) {
      say(err instanceof ProgressImportError ? err.message : 'Import failed.', 'error');
    } finally {
      fileInput.value = '';
    }
  });

  document.querySelector('#reset')!.addEventListener('click', () => {
    if (!confirm('Erase all progress and quiz results in this browser? Export first if you want a backup.')) return;
    store.reset();
    say('Progress reset.');
  });
</script>
